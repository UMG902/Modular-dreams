{
        "schemaVersion": 1,
        "id": "modular_dreams",
        "version": "${version}",
        "name": "Modular Dreams v2",
        "description": "Fresh-start modular equipment overhaul: craft tool parts at the Part Picker, assemble them at the Assembler, and convert your vanilla tools. Handle + head, rose gold and spears included.",
        "authors": [
                "Modular Dreams Team"
        ],
        "contact": {
                "homepage": "https://github.com/UMG902/Modular-dreams",
                "sources": "https://github.com/UMG902/Modular-dreams"
        },
        "license": "CC0-1.0",
        "icon": "assets/modular_dreams/icon.png",
        "environment": "*",
        "mixins": [
                "modular_dreams.mixins.json"
        ],
        "classtweaker": "modular_dreams.classtweaker",
        "entrypoints": {
                "main": [
                        "com.modulardreams.ModularDreams"
                ],
                "client": [
                        "com.modulardreams.client.ModularDreamsClient"
                ]
        },
        "depends": {
                "fabricloader": ">=0.19.5",
                "minecraft": "~26.3",
                "java": ">=25",
                "fabric-api": "*"
        }
}
